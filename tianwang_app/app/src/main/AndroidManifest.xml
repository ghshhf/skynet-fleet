<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🔴 Net.kt 已真接云侧（HTTP/SSE），INTERNET 权限是硬前提——
         没有它所有请求静默失败，表现为「填什么都连不上」。
         其余敏感权限（RECORD_AUDIO/前台服务…）仍按老工程清单逐条搬，不预开。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 手机入网要长期在线：前台服务 + Android 14 的 dataSync 类型。
         通知权限只影响通知是否可见，不影响服务启动；开机自启是尽力而为
         （Android 15 对 BOOT_COMPLETED 启动 dataSync 有限制，失败会回落直连）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 语音输入：录音上传给云侧 /api/voice/recognize。没有麦克风的设备也能装，
         只是聊天页的麦克风会提示不可用。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- 本机自持：读网络类型 + 调媒体音量。两条都是普通权限，装了就直接可用，
         没有运行时授权弹窗。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Shizuku：借一次无线调试授权拿到 shell（uid 2000）身份。
         没装 Shizuku 时这条权限和 provider 都不生效，不影响其它能力。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 按包名打开 App 需要「包可见性」。只放开带启动入口的应用，
         不申请 QUERY_ALL_PACKAGES —— 少一个敏感权限，能力面没少。
         Shizuku 管理器要单独列出，否则 Android 11+ 连「装没装」都查不到。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.manager" />
        <package android:name="com.rosan.dhizuku" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TianwangNext">

        <!-- 手机自持通道。BIND_ACCESSIBILITY_SERVICE 是系统签名权限，
             只有用户在设置里手动授权后系统才会绑上来。 -->
        <service
            android:name=".PhoneAccessService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- 通知监听。BIND_NOTIFICATION_LISTENER_SERVICE 是系统签名权限，
             只有用户在「通知使用权」里手动勾选后系统才会绑上来。 -->
        <service
            android:name=".NotificationWatch"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 入网链接的常驻壳：只负责前台通知 + 把 PhoneMcpLink 拉起来。
             真正的 WebSocket 与断线重连都在 PhoneMcpLink，不在 Service 里。 -->
        <service
            android:name=".PhoneLinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 真机验证桥：只在 debug 构建存在（release 里 enabled=false，整条通道消失）。
             这台手机的 ROM 删了 adb input 的注入权限，屏幕点不了、字打不进，
             但「工具在真机上跑不跑得通」必须实测 —— 用带 token 的广播调工具/跑一次闭环。
             token 是首次启动随机生成的，存在应用自己的外部目录，别的 App 读不到。 -->
        <receiver
            android:name=".DebugBridge"
            android:enabled="${debugBridge}"
            android:exported="true">
            <intent-filter>
                <action android:name="app.skynet.tianwang.next.DEBUG" />
            </intent-filter>
        </receiver>

        <!-- 设备所有者锚点。全新手机可用一条 adb 命令把本 App 设为设备所有者
             （self.owner.provision 会给命令），不需要 root / 解锁 Bootloader。
             只有系统能发 DEVICE_ADMIN_ENABLED，所以 exported=true + 系统签名权限。 -->
        <receiver
            android:name=".OwnerReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku 的入口 provider：负责把 Shizuku 的 binder 交给 api 库。
             authorities 必须带 ${applicationId}.shizuku 后缀，多个 App 才不撞车。
             ShellService **不在这里声明**——它由 Shizuku 在 shell 进程里反射实例化。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:enabled="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
