<?xml version="1.0" encoding="utf-8"?>
<!-- 编队桥：手机侧唯一组件。无界面、无网络外联，只开一个 loopback 控制端口。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.fleet.bridge"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- 只为了在 127.0.0.1 上开控制端口，不接受外部连接 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 红外发射：普通权限，安装即得，不需要 root 也不需要无障碍 -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />

    <!-- 保活壳（2026-11-01）：普通前台服务，只为把进程优先级抬起来。
         不用 dataSync：Android 14+ 给它按了「每 24 小时 6 小时」的配额，
         跑满就再也起不来。specialUse 没有时长配额，才撑得住「一直在」。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 通知权限：没它前台服务的通知不显示，桥被杀了用户看不见 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 蓝牙扫描：只扫不连。BLUETOOTH_SCAN 带 neverForLocation，
         这样不申请定位权限也能扫到设备（不拿它推位置）。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:hasCode="true">

        <!-- 只为申请「附近的设备」权限而存在，申请完立即关闭 -->
        <activity
            android:name=".BridgeSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <service
            android:name=".BridgeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 保活壳：不干活，只让进程以前台服务身份活着。
             exported=false —— 它没有对外入口，只能由本应用（或 am start 拉起的
             BridgeSetupActivity）触发。START_STICKY 由代码里的 onStartCommand 给。 -->
        <service
            android:name=".BridgeKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local accessibility control bridge" />
        </service>
    </application>
</manifest>
