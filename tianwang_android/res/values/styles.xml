<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色为默认，深色在 values-night/styles.xml（只覆盖状态栏图标明暗）。
         NoActionBar：标题我们自己排——要两行（页面名 + 当前模型名）。 -->
    <style name="TianWangTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
    </style>

    <!-- 抽屉菜单项：图标 + 文字，平时无底色，按下才浮一层（参考页观感）。
         尺寸只在这一处定义，六项不会出现"这个高一点那个矮一点"。 -->
    <style name="DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_drawer_item</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 出图页仍在用的胶囊（那一页还没重做，先留着，别把它编坏） -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 对话气泡：我说的话靠右、淡绿；它说的话靠左、浅灰。
         左右分色是唯一的"谁在说"提示——加头像会把一屏能放的行数砍一半。 -->
    <style name="Bubble">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">300dp</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
