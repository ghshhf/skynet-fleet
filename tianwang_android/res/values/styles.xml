<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色打底：光球是唯一亮源，四周压暗才能看出"在听"和"在说"的区别 -->
    <style name="TianWangTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/text_dim</item>
    </style>

    <!-- 功能条上的胶囊按钮。定义成 style 是为了六个按钮只有一处尺寸，
         改一次全都跟着改，不会出现"这个高一点那个矮一点"。 -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 对话气泡：我说的话靠右、蓝底；它说的话靠左、灰底。
         左右分色是唯一的"谁在说"提示——加头像会把一屏能放的行数砍一半。 -->
    <style name="Bubble">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">300dp</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
