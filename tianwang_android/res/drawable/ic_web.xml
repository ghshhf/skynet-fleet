<?xml version="1.0" encoding="utf-8"?>
<!-- 联网：地球（外圈 + 赤道 + 一条经线）。
     为什么用地球而不是「插头/云」：插头在 16dp 下糊成一个黑块，
     云又容易跟"云同步"混。圆 + 十字是唯一小尺寸还认得出的联网符号。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp" android:height="16dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/icon"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M12,3.2 A8.8,8.8 0 1 0 12,20.8 A8.8,8.8 0 1 0 12,3.2 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/icon"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M3.4,12 L20.6,12" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/icon"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M12,3.2 C8.6,6.2 8.6,17.8 12,20.8 C15.4,17.8 15.4,6.2 12,3.2 Z" />
</vector>
