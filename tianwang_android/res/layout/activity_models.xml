<?xml version="1.0" encoding="utf-8"?>
<!--
  模型库：App 内本地下载界面。
  一屏滚动：标题 + 提示 + 自定义 HF 直链输入框 + 模型列表（动态行）。
  动态行在 ModelActivity 里 addView 进 @id/listModels。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模型库"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手机经代理直连 Hugging Face 下载，不靠电脑推。移动网络易断会自动续传。"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/editUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hugging Face 直链（resolve/.../*.gguf）"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listModels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
