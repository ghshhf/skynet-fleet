<?xml version="1.0" encoding="utf-8"?>
<!--
  手机出图界面（N+1c）：prompt + 步数 + 尺寸 + 生成 → 本地 Termux 出图 → 展示。
  配色复用主界面：bg / text / text_dim。尺寸按钮选中态在 Java 里改背景色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="出图"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:padding="8dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/editPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="想画什么？一句话描述"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:maxLines="3"
        android:padding="12dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="步数"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editSteps"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_input"
            android:inputType="number"
            android:maxLength="2"
            android:text="10"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="尺寸"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSize512"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="512"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSize768"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="768"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSize1024"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="1024"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnGen"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_send"
        android:text="生成"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="32dp"
        android:text="准备就绪"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/imgResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:scaleType="fitCenter"
        android:background="@color/bg" />

    <Button
        android:id="@+id/btnRegen"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:text="换一张（新种子）"
        android:textColor="@color/text"
        android:textSize="14sp" />
</LinearLayout>
