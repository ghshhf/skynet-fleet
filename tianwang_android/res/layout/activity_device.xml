<?xml version="1.0" encoding="utf-8"?>
<!--
  设备检测页：把"这台机到底有什么、跑多快"摊开给人看。
  三块：上面是实测到的硬件 + 三档预估，中间是本次结果，下面是三个动作。
  全部数字都来自实测（Vulkan 清单 / proc/meminfo / 真跑一张），没有一项是猜的。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDevBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设备检测"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDevInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="读取中…"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/txtDevResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnDevProbe"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="检测硬件" />

        <Button
            android:id="@+id/btnDevBench"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="跑基准" />

        <Button
            android:id="@+id/btnDevClear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="清除档案" />
    </LinearLayout>
</LinearLayout>
