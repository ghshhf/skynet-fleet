<?xml version="1.0" encoding="utf-8"?>
<!--
  天网 · 手机原生端

  纯原生 View 实现，不走 WebView：光球是自定义 Canvas，录音是 AudioRecord，
  网络是 HttpURLConnection。唯一的后端依赖是电脑上那个 fleet/gui 服务，
  通过 adb reverse 把手机的回环口接到电脑上。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.skynet.tianwang"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- 只连 127.0.0.1（adb reverse 转出去），不主动外联 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 录音：运行时申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:hasCode="true"
        android:theme="@style/TianWangTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 本地语音自检：用来单独确认「.so / 模型 / 音频格式」哪一环出问题。
             设为导出是为了让 adb shell am start 能拉起（不导出的话 shell 起不来，
             自检就失去意义）。它只读本地文件、做一次识别，不写外部状态，
             也不返回任何数据给调用方，被别的应用拉起的风险可以接受。 -->
        <activity
            android:name=".SelfTestActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
